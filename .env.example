# Solana RPC endpoint
# - mainnet-beta: https://api.mainnet-beta.solana.com
# - devnet: https://api.devnet.solana.com
NEXT_PUBLIC_RPC_URL=https://api.mainnet-beta.solana.com

# SPL token mint used for gating (leave blank for UI-only deploy)
NEXT_PUBLIC_TOKEN_MINT=

# Minimum token amount required to play (in base units, NOT decimals-adjusted)
NEXT_PUBLIC_MIN_TOKENS=1000000
